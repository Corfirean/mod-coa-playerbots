diff --git a/src/server/game/Maps/InterleavedUpdateClock.h b/src/server/game/Maps/InterleavedUpdateClock.h
new file mode 100644
--- /dev/null
+++ b/src/server/game/Maps/InterleavedUpdateClock.h
@@ -0,0 +1,83 @@
+/*
