#
# mod-coa-playerbots
#

[worldserver]

# Number of bots '.botcmd spawnrandom' creates when no count is given on the command line.
CoaBots.RandomSpawn.DefaultCount = 10

# Safety cap: a single '.botcmd spawnrandom <count>' invocation never creates more than this
# many bots at once, regardless of what's requested. Each bot is a synchronous DB clone of an
# existing level-80 test character, so a very large batch will cause a visible tick hitch --
# raise this only on a dev/test realm with nobody else online.
CoaBots.RandomSpawn.MaxCount = 1000

# If enabled, each newly created bot is immediately logged in (queued through the same
# null-socket login path '.botcmd spawnbot' uses) instead of only existing in the database
# until spawned by guid later.
CoaBots.RandomSpawn.AutoLogin = 1

# How many bots '.botcmd spawnrandom'/'.botcmd spawnleveled' create per batch, and how many
# milliseconds to wait between batches. Confirmed live: creating ~1000 bots synchronously
# crashed the worldserver outright (no crash dump -- consistent with an OS-level kill under a
# resource spike). The defaults (5 bots every 500ms = 10/sec) survived a live 1000-1500 bot
# batch with no crash; lower BatchSize or raise BatchIntervalMs further on weaker hardware.
CoaBots.RandomSpawn.BatchSize = 5
CoaBots.RandomSpawn.BatchIntervalMs = 500

# Username prefix for the accounts random bots are spread across (auto-created as needed, one
# new account whenever the current one hits CharactersPerAccount). Never account 1 (the human
# player's own account) or account 2 if it's the hand-made test-character account -- new
# accounts are always created fresh under this prefix.
CoaBots.RandomSpawn.AccountPrefix = "CoaBotHost"

# If enabled, every bot character that already exists (any account matching
CoaBots.AutoLoginOnStartup = 0
CoaBots.AutoLogin.MaxCount = 800

# Batch size / interval for CoaBots.AutoLoginOnStartup's gradual login. Login is much lighter
# than character creation (just an async DB query per bot), so this can safely run faster than
# CoaBots.RandomSpawn's batch pace -- default is 10 bots every 500ms (20/sec).
CoaBots.AutoLogin.BatchSize = 10
CoaBots.AutoLogin.BatchIntervalMs = 500

# Human-like solo behavior: a bot has a persistent profile and keeps one intent instead of
# retrying a fixed quest/gather/fish/grind sequence on every idle tick. Values are milliseconds.
CoaBots.Profile.IntentMinMs = 900000
CoaBots.Profile.IntentMaxMs = 2100000

# When enabled, the moment anyone (real player or bot) joins a normal (non-arena, non-rated)
# Battleground queue, both factions' queues for that bracket are automatically topped off with
# bots so the match is always full and pops immediately.
CoaBots.BGFill.Enable = 1

# How many bots per team to top a queue off to. 0 = use the battleground's own real
# max-players-per-team (a genuinely full match); lower it to test with a smaller population.
CoaBots.BGFill.TargetPlayersPerTeam = 0

# When enabled, a solo player queuing for a dungeon (not raid) via the Dungeon Finder is
# automatically joined by bots for whichever of Tank/Healer/3x Damage their own role selection
# doesn't already cover, so a full 5-man is ready immediately. Group joins and raids are out of
# scope -- see BotLfgFill.cpp's header comment.
CoaBots.LfgFill.Enable = 1

# Path to the community talent-build data (see reference/ascensionsidekick-level-builds.json in
# the module's own repo, sourced from ascensionsidekick.com) that bots use to spend real talent
# points as they level. Leave blank to use the built-in search (checks this path relative to the
# working directory, one level up, two levels up, and a hardcoded dev-machine path as a last
# resort) -- only set this if the file lives somewhere none of those find it.
CoaBots.TalentBuildsPath = ""

# Bots below level 10 have no specialization yet. Once a bot hits level 10 without one, it's
# assigned a spec from the community build data, weighted toward whichever role (Tank/Healer)
# the current online bot population is short of relative to these target percentages; DPS is
# always the fallback. Raise TankTargetPct/HealerTargetPct if dungeon/raid groups keep running
# short on tanks or healers.
CoaBots.SpecBalance.TankTargetPct = 20
CoaBots.SpecBalance.HealerTargetPct = 20

# How low a heal target's health can drop (percent) before a healer bot breaks formation /
# stops following to cast a heal, even with nothing else going on (no active group fight). Below
# this, the heal always happens; above it, a healer keeps following the group and only heals
# incidentally while doing so. Raise this if healers feel too passive about topping people off;
# lower it if they break formation too often for trivial chip damage.
CoaBots.Healer.CriticalHealPct = 50

# How far (yards) a solo/ungrouped bot with nothing else to do will scan for a hostile to grind
# on, and how many levels above its own level a target can be before it's skipped as too
# dangerous. Lower SearchRadius if idle bots are grinding mobs uncomfortably far from where you'd
# expect to find them; lower MaxLevelAbove if they're picking fights they shouldn't win.
CoaBots.Grind.SearchRadius = 30
CoaBots.Grind.MaxLevelAbove = 3

# Ambient world behavior (src/world/BotWorldBehavior.cpp): gives an idle, ungrouped bot a concrete
# errand -- town services, a trip to a gathering or grinding area, or a short wander -- once its own
# quest/gather/fish/grind scans have found nothing nearby. Never runs for grouped bots, under Stay,
# in battlegrounds or dungeons, or during combat.
CoaBots.World.Enable = 1

# How often each bot re-evaluates its errand. Bots are staggered across this interval so a large
# population never thinks on the same tick.
CoaBots.World.ThinkIntervalMs = 2000

# Outside cities, how long the solo scans must keep coming up empty before an errand starts.
CoaBots.World.IdleBeforeErrandMs = 10000

# Search radius (yards) for service NPCs and mailboxes, and for gathering/grinding destinations.
CoaBots.World.ServiceRadius = 200
CoaBots.World.AreaRadius = 350

# Log every errand transition (chose / arrived / completed / expired / resumed) to the
# module.coa-playerbots.world log category. Useful while tuning, noisy with thousands of bots.
CoaBots.World.VerboseLog = 1

# Level distribution for `.botcmd spawnleveled`: comma-separated "low-high:weight" brackets.
# The default gives many levelling bots and few at the cap: 40% 1-20, 33% 21-60, 20% 61-79, 7% 80.
CoaBots.LeveledSpawn.Brackets = "1-20:40,21-60:33,61-79:20,80-80:7"
